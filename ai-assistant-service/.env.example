# Gateway base URL (the Java API gateway)
GATEWAY_URL=http://localhost:8080

# JWT the assistant uses to call protected business endpoints on behalf of a user.
SERVICE_TOKEN=

# OpenAI / Azure OpenAI. Leave OPENAI_API_KEY empty to run in offline fallback mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

KNOWLEDGE_PATH=data/knowledge.md
